<Window x:Class="Shigaflow.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Download" Height="245" Width="600" MinWidth="520" MinHeight="245"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="ADD NEW DOWNLOAD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock Grid.Row="1" Text="Paste a direct HTTP or HTTPS download link." FontSize="20" FontWeight="Bold" Margin="0,6,0,14"/>
        <TextBox x:Name="UrlInput" Grid.Row="2" Height="42" VerticalContentAlignment="Center"
                 ToolTip="Paste a direct HTTP or HTTPS file URL"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="95" Click="Cancel_Click"/>
            <Button Content="Continue  →" MinWidth="125" Margin="10,0,0,0" Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
