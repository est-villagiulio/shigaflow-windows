<Window x:Class="Shigaflow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Shigaflow Settings" Height="650" Width="700" MinHeight="650" MinWidth="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SHIGAFLOW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Settings" FontSize="21" FontWeight="Bold" Margin="0,5,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1" x:Name="SettingsTabs"
                    Background="{DynamicResource PanelBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    Padding="0">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
                    <Setter Property="Padding" Value="12,7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0"
                                        CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Download Setting">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,14,8,8">
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                    <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectedIndex="0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Dark"/>
                                        <ComboBoxItem Content="Light"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="StartupCheck" Foreground="{DynamicResource TextBrush}" Content="Start Shigaflow when I sign in to Windows" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Adds or removes Shigaflow from your personal Windows startup entries." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Browser download file types" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Only files with these extensions can be sent from Chrome or Edge to Shigaflow. Separate extensions with commas, spaces, or semicolons. Include or omit the dot."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBox x:Name="AllowedExtensionsBox" MinHeight="34" Padding="8" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         ToolTip="Example: zip, rar, pdf, mp4, exe"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15">
                            <StackPanel>
                                <CheckBox x:Name="SpeedLimitCheck" Foreground="{DynamicResource TextBrush}" Content="Limit total download speed" FontSize="13" FontWeight="SemiBold" Checked="SpeedLimitCheck_Changed" Unchecked="SpeedLimitCheck_Changed"/>
                                <TextBlock Text="The limit is shared across all active downloads." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                <Grid x:Name="SpeedOptions">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="SpeedValueBox" Grid.Column="0" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Enter a positive number"/>
                                    <ComboBox x:Name="SpeedUnitBox" Grid.Column="1" SelectedIndex="1" VerticalContentAlignment="Center" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource PanelAltBrush}">
                                        <ComboBoxItem Content="KB/s" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource PanelBrush}"/>
                                        <ComboBoxItem Content="MB/s" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource PanelBrush}"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Torrent Setting">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,14,8,8">
                        <TextBlock Text="Torrent bandwidth" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,12"/>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="TorrentDownloadLimitCheck" Foreground="{DynamicResource TextBrush}" Content="Limit torrent download speed" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Maximum combined download speed across active torrents. Leave unchecked for unlimited speed." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TorrentDownloadValueBox" Grid.Column="0" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Enter a positive number"/>
                                    <ComboBox x:Name="TorrentDownloadUnitBox" Grid.Column="1" SelectedIndex="1" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="KB/s"/><ComboBoxItem Content="MB/s"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="TorrentUploadLimitCheck" Foreground="{DynamicResource TextBrush}" Content="Limit torrent upload speed" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Maximum combined upload speed used while sharing torrent pieces with peers." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TorrentUploadValueBox" Grid.Column="0" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Enter a positive number"/>
                                    <ComboBox x:Name="TorrentUploadUnitBox" Grid.Column="1" SelectedIndex="1" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="KB/s"/><ComboBoxItem Content="MB/s"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15">
                            <StackPanel>
                                <TextBlock Text="When a torrent finishes downloading" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ComboBox x:Name="TorrentAfterFinishBox" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Continue seeding" Tag="Seed"/>
                                    <ComboBoxItem Content="Stop torrent" Tag="Stop"/>
                                </ComboBox>
                                <TextBlock Text="Seeding shares completed pieces with other peers. Stop keeps the downloaded files but stops the torrent transfer." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Torrent speed limits are applied when Shigaflow starts. Restart the app after changing these limits." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,12,2,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="How To">
                <ScrollViewer x:Name="HowToScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource PanelBrush}"
                              CanContentScroll="False">
                    <Image Source="/Shigaflow;component/Assets/how-to.jpg"
                           Width="{Binding ElementName=HowToScrollViewer, Path=ViewportWidth}"
                           Stretch="Uniform" HorizontalAlignment="Center"
                           VerticalAlignment="Top" SnapsToDevicePixels="True"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource PanelBrush}" CanContentScroll="False">
                    <StackPanel Background="{DynamicResource PanelBrush}" Margin="0">
                        <!-- Keep the wide photo frame fully visible when the About tab opens. -->
                        <Image Source="/Shigaflow;component/Assets/klhw.png"
                               Height="390" Stretch="UniformToFill"
                               HorizontalAlignment="Stretch" VerticalAlignment="Top"
                               Margin="0" ClipToBounds="True" SnapsToDevicePixels="True"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="Bold" Margin="0,14,0,8">
                            <Hyperlink NavigateUri="https://maps.app.goo.gl/EBKVQ3E5oapocFxD7" RequestNavigate="KLHWLink_RequestNavigate" Foreground="{DynamicResource AccentBrush}">KLHW</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Shigaflow" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" MinWidth="90"/>
            <Button Content="Save settings" Click="Save_Click" MinWidth="120" Margin="0" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
